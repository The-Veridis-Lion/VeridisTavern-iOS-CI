+/// Read the SillyTavern server setting carried under the data root by an archive.
+pub async fn load_st_prompt_placeholder(data_root: &Path) -> Result<String, DomainError> {
+    let contents = match fs::read_to_string(data_root.join("config.yaml")).await {
+        Ok(contents) => contents,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+            // A new SillyTavern installation receives this value from default/config.yaml.
+            return Ok("[Start a new chat]".to_owned());
+        }
+        Err(error) => {
+            return Err(DomainError::InternalError(format!(
+                "Read config.yaml: {error}"
+            )));
+        }
+    };
+    let config: yaml_serde::Value = yaml_serde::from_str(&contents)
+        .map_err(|_| DomainError::InvalidData("Invalid SillyTavern config.yaml".to_owned()))?;
+    match config.get("promptPlaceholder") {
+        None => Ok("Let's get started.".to_owned()),
+        Some(yaml_serde::Value::Null) => Ok(String::new()),
+        Some(yaml_serde::Value::String(text)) => Ok(text.clone()),
+        Some(_) => Err(DomainError::InvalidData(
+            "SillyTavern config.yaml promptPlaceholder must be text or null".to_owned(),
+        )),
+    }
+}
