+#[tokio::test]
+async fn character_chat_selection_uses_the_persisted_card_and_can_retry() {
+    use tt_application::dto::character_dto::PersistCharacterChatSelectionDto;
+
+    let temp = tempfile::tempdir().expect("create temp dir");
+    let root = temp.path();
+    let service = character_service(root).await;
+    let path = root.join("default-user/characters/Alice.png");
+    let mut card = character_card("Alice", json!({ "custom": "kept" }));
+    card["avatar"] = json!("Alice.png");
+    card["chat"] = json!("selected");
+    // A normal merge strips this legacy field even when the selection is identical.
+    card["json_data"] = json!("legacy duplicate");
+    let matching_png = character_png(&card);
+    fs::write(&path, &matching_png)
+        .await
+        .expect("write matching card");
+    assert_eq!(
+        service
+            .get_character("Alice")
+            .await
+            .expect("prime card cache")
+            .chat,
+        "selected"
+    );
+    let selection = || PersistCharacterChatSelectionDto {
+        avatar: "Alice.png".to_string(),
+        chat: "selected".to_string(),
+    };
+
+    service
+        .persist_character_chat_selection(selection())
+        .await
+        .expect("confirm selection");
+    assert_eq!(
+        fs::read(&path).await.expect("read untouched card"),
+        matching_png
+    );
+
+    fs::write(&path, b"broken png")
+        .await
+        .expect("damage stored card");
+    service
+        .persist_character_chat_selection(selection())
+        .await
+        .expect_err("a cached match cannot hide the disk error");
+
+    card["chat"] = json!("old");
+    fs::write(&path, character_png(&card))
+        .await
+        .expect("restore a different chat on disk");
+    service
+        .persist_character_chat_selection(selection())
+        .await
+        .expect("retry selection");
+    let stored = read_stored_card(root, "Alice").await;
+    assert_eq!(stored.get("chat"), Some(&json!("selected")));
+    assert_eq!(stored.pointer("/unknownTop/kept"), Some(&json!(true)));
+    assert!(
+        !stored
+            .as_object()
+            .expect("card object")
+            .contains_key("json_data")
+    );
+}
